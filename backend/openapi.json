  },
  "components": {
    "schemas": {
      "AccessScope": {
        "properties": {
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "territories": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Territories"
          },
          "record_types": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Record Types"
          },
          "max_sensitivity": {
            "type": "string",
            "enum": [
              "public",
              "internal",
              "confidential",
              "restricted"
            ],
            "title": "Max Sensitivity"
          }
        },
        "type": "object",
        "required": [
          "role",
          "territories",
          "record_types",
          "max_sensitivity"
        ],
        "title": "AccessScope"
      },
      "AccountBrief": {
        "properties": {
          "summary": {
            "type": "string",
            "maxLength": 1200,
            "minLength": 10,
            "title": "Summary"
          },
          "summary_source_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Summary Source Ids"
          },
          "key_facts": {
            "items": {
              "$ref": "#/components/schemas/Claim"
            },
            "type": "array",
            "maxItems": 8,
            "title": "Key Facts"
          },
          "recent_activity": {
            "items": {
              "$ref": "#/components/schemas/Claim"
            },
            "type": "array",
            "maxItems": 6,
            "title": "Recent Activity"
          },
          "risks": {
            "items": {
              "$ref": "#/components/schemas/Claim"
            },
            "type": "array",
            "maxItems": 6,
            "title": "Risks"
          }
        },
        "type": "object",
        "required": [
          "summary",
          "summary_source_ids",
          "key_facts",
          "recent_activity",
          "risks"
        ],
        "title": "AccountBrief"
      },
      "AccountListItem": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "industry": {
            "type": "string",
            "title": "Industry"
          },
          "territory": {
            "type": "string",
            "title": "Territory"
          },
          "tier": {
            "type": "string",
            "title": "Tier"
          },
          "city": {
            "type": "string",
            "title": "City"
          },
          "owner_name": {
            "type": "string",
            "title": "Owner Name"
          },
          "use_case": {
            "type": "string",
            "title": "Use Case"
          },
          "synthetic": {
            "type": "boolean",
            "title": "Synthetic",
            "default": true
          },
          "opportunity_stage": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Opportunity Stage"
          },
          "next_meeting": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Meeting"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "industry",
          "territory",
          "tier",
          "city",
          "owner_name",
          "use_case",
          "synthetic",
          "opportunity_stage",
          "next_meeting"
        ],
        "title": "AccountListItem"
      },
      "AccountSummary": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "industry": {
            "type": "string",
            "title": "Industry"
          },
          "territory": {
            "type": "string",
            "title": "Territory"
          },
          "tier": {
            "type": "string",
            "title": "Tier"
          },
          "city": {
            "type": "string",
            "title": "City"
          },
          "owner_name": {
            "type": "string",
            "title": "Owner Name"
          },
          "use_case": {
            "type": "string",
            "title": "Use Case"
          },
          "synthetic": {
            "type": "boolean",
            "title": "Synthetic",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "industry",
          "territory",
          "tier",
          "city",
          "owner_name",
          "use_case",
          "synthetic"
        ],
        "title": "AccountSummary"
      },
      "Answer": {
        "properties": {
          "answer": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Answer"
          },
          "claims": {
            "items": {
              "$ref": "#/components/schemas/Claim"
            },
            "type": "array",
            "maxItems": 8,
            "title": "Claims"
          }
        },
        "type": "object",
        "required": [
          "answer",
          "claims"
        ],
        "title": "Answer"
      },
      "AskRequest": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 3,
            "title": "Question"
          },
          "account_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Account Id"
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "AskRequest"
      },
      "AskResponse": {
        "properties": {
          "question": {
            "type": "string",
            "title": "Question"
          },
          "result": {
            "$ref": "#/components/schemas/Answer"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "type": "array",
            "title": "Citations"
          },
          "meta": {
            "$ref": "#/components/schemas/ResponseMeta"
          }
        },
        "type": "object",
        "required": [
          "question",
          "result",
          "citations",
          "meta"
        ],
        "title": "AskResponse"
      },
      "Attendee": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "title": {
            "type": "string",
            "title": "Title"
          }
        },
        "type": "object",
        "required": [
          "name",
          "title"
        ],
        "title": "Attendee"
      },
      "AuditEntry": {
        "properties": {
          "ts": {
            "type": "string",
            "title": "Ts"
          },
          "trace_id": {
            "type": "string",
            "title": "Trace Id"
          },
          "user_id": {
            "type": "string",
            "title": "User Id"
          },
          "role": {
            "type": "string",
            "title": "Role"
          },
          "action": {
            "type": "string",
            "title": "Action"
          },
          "account_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Account Id"
          },
          "provider": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider"
          },
          "record_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Record Ids"
          },
          "guardrail_events": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Guardrail Events"
          },
          "outcome": {
            "type": "string",
            "title": "Outcome"
          }
        },
        "type": "object",
        "required": [
          "ts",
          "trace_id",
          "user_id",
          "role",
          "action",
          "account_id",
          "provider",
          "record_ids",
          "guardrail_events",
          "outcome"
        ],
        "title": "AuditEntry"
      },
      "BriefResponse": {
        "properties": {
          "account": {
            "$ref": "#/components/schemas/AccountSummary"
          },
          "brief": {
            "$ref": "#/components/schemas/AccountBrief"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "type": "array",
            "title": "Citations"
          },
          "meta": {
            "$ref": "#/components/schemas/ResponseMeta"
          }
        },
        "type": "object",
        "required": [
          "account",
          "brief",
          "citations",
          "meta"
        ],
        "title": "BriefResponse"
      },
      "Citation": {
        "properties": {
          "source_id": {
            "type": "string",
            "title": "Source Id"
          },
          "record_id": {
            "type": "string",
            "title": "Record Id"
          },
          "source_type": {
            "type": "string",
            "enum": [
              "account",
              "contact",
              "opportunity",
              "activity",
              "email",
              "meeting",
              "product_doc"
            ],
            "title": "Source Type"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "snippet": {
            "type": "string",
            "title": "Snippet"
          }
        },
        "type": "object",
        "required": [
          "source_id",
          "record_id",
          "source_type",
          "title",
          "snippet"
        ],
        "title": "Citation"
      },
      "Claim": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 600,
            "minLength": 3,
            "title": "Text"
          },
          "source_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 6,
            "minItems": 1,
            "title": "Source Ids"
          }
        },
        "type": "object",
        "required": [
          "text",
          "source_ids"
        ],
        "title": "Claim"
      },
      "GuardrailEvent": {
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "prompt_injection",
              "pii_redaction",
              "invalid_citation",
              "validation_retry",
              "fallback"
            ],
            "title": "Type"
          },
          "source_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Id"
          },
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "type",
          "source_id",
          "detail"
        ],
        "title": "GuardrailEvent"
      },
