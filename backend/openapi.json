    "/api/audit": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Audit",
        "operationId": "audit_api_audit_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 50,
              "title": "Limit"
            }
          },
          {
            "name": "x-user-id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Demo identity; production would use OIDC/JWT",
              "title": "X-User-Id"
            },
            "description": "Demo identity; production would use OIDC/JWT"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AuditEntry"
                  },
                  "title": "Response Audit Api Audit Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
