{
  "openapi": "3.1.0",
  "info": {
    "title": "Sales AI Copilot API",
    "description": "Account briefs, meeting prep, next-best-actions and Q&A over synthetic CRM data, with role/territory access control, PII redaction, guardrails and citations.",
