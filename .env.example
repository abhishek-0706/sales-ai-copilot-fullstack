# Copy to .env (never commit real keys). Offline deterministic mode is the default when nothing is set.
# LLM_PROVIDER=offline | openai_compat (alias: nim) | gemini
LLM_PROVIDER=offline

# OpenAI-compatible endpoint: NVIDIA NIM on the API catalog by default.
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_API_KEY=
# LLM_API_KEY takes precedence over NVIDIA_API_KEY if both are set (useful for vLLM with --api-key).
LLM_API_KEY=
# LLM_JSON_MODE=true sends response_format={"type":"json_object"} (only if your server supports it).
LLM_JSON_MODE=false

# Local alternatives with the same code path (no key needed):
#   Ollama: LLM_PROVIDER=openai_compat LLM_BASE_URL=http://localhost:11434/v1 LLM_MODEL=llama3.1:8b
#   vLLM:   LLM_PROVIDER=openai_compat LLM_BASE_URL=http://localhost:8001/v1 LLM_MODEL=<served model name>

# Optional Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Retrieval: hash (default, no download) or fastembed (local BAAI/bge-small-en-v1.5, ~65 MB one-off download)
EMBEDDER=hash
RETRIEVAL_K=6

# Observability: print OpenTelemetry spans to stdout
OTEL_CONSOLE=false
